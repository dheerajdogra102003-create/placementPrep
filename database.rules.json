{
  "rules": {
    "users": {
      "$username": {
        ".read": true,
        ".write": "newData.exists() && (!data.exists() || newData.child('username').val() === $username)",
        ".validate": "newData.hasChildren(['username', 'lastSynced']) && newData.child('username').isString() && newData.child('username').val().length >= 2 && newData.child('username').val().length <= 30"
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
